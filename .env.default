# ── Viewer: base imagery / tiles providers (build-time, injected by vite) ──
CESIUM_ION_TOKEN=your_cesium_ion_token_here
GOOGLE_MAP_PLATFORM=your_google_maps_api_key_here
MAPBOX_API_KEY=your_mapbox_api_key_here
ESRI_API_ID=your_esri_api_id_here
ESRI_API_KEY=your_esri_api_key_here
ESRI_API_SECRET=your_esri_api_secret_here

# ── Companion Atlas server (server/) ───────────────────────────────────────
# Where the published viewer and the API live (used to build share URLs).
ATLAS_VIEWER_BASE_URL=http://localhost:4173
ATLAS_API_BASE_URL=http://localhost:8787/api

# Infrastructure (docker-compose provides these in-cluster).
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=atlas

# ── Companion Intelligence suite connectors ────────────────────────────────
# CI-Server memory: seed stories from geotagged memories + write stories back.
CI_MEMORY_URL=
# OpenClaw / Hermes: suite agents that drive Atlas via MCP and receive results.
OPENCLAW_URL=
HERMES_URL=

# ── Companion OIDC (auth for REST + MCP-over-HTTP) ─────────────────────────
# Leave the issuer empty to disable auth locally (single dev subject).
COMPANION_OIDC_ISSUER=
COMPANION_OIDC_AUDIENCE=companion-atlas
COMPANION_OIDC_CLIENT_ID=
COMPANION_OIDC_CLIENT_SECRET=
ATLAS_DEV_SUBJECT=dev-operator
