{
  "name": "companion-atlas-desktop-shell",
  "private": true,
  "version": "0.2.2",
  "description": "Companion Atlas desktop shell (Tauri 2)",
  "scripts": {
    "tauri": "tauri",
    "dev": "npm run notices && tauri dev",
    "build": "npm run icons && npm run notices && tauri build",
    "build:debug": "npm run icons && npm run notices && tauri build --debug",
    "test:native": "node --test tests/*.test.mjs",
    "icons": "tauri icon \"../public/icons/icon-512.png\" --output src-tauri/icons",
    "notices": "node ../../scripts/third-party-notices.mjs --scope web,desktop --out src-tauri/notices"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4"
  }
}
