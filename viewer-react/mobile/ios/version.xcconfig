// The one place the version numbers of both store builds are set. The iOS target reads this
// file (Release directly, Debug through debug.xcconfig), and the Android Gradle build reads it too.
// MARKETING_VERSION is the name users see (CFBundleShortVersionString, Android versionName).
// CURRENT_PROJECT_VERSION is the build number (CFBundleVersion, Android versionCode). It must be a
// whole number, and it must go up for every upload to either store (Play rejects a reused versionCode).
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1
