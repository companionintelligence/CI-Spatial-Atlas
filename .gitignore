/node_modules

# Secrets. Deliberately NOT anchored with a leading slash: these patterns must
# match in every workspace, not just the repo root. viewer-react/.env holds a
# real Cesium ion token and a Google Maps key, and until now it was covered
# only by viewer-react/.gitignore — a .env dropped in server/ or packages/*
# would have been committed. `.env.dev` matters too: docker-compose.dev.yml
# reads it via `env_file`, so it carries live credentials.
.env
.env.*
# ...but the committed templates are documentation and stay tracked.
!.env.default
!.env.example
!.env.dev.example

# Viewer build output + Playwright capture artifacts
/viewer-react/dist
/viewer-react/capture-results

# Nested Atlas server package
/server/node_modules
/server/dist

# Workspace packages build output (e.g. packages/story-schema/dist)
/packages/*/dist

# Test + build artifacts
/test-results
/playwright-report
capture/

# Deno lockfile — not committed yet: viewer-react's @companionintelligence/tokens
# dependency lives on a private GitHub Packages registry (see viewer-react/.npmrc)
# and `deno install`/`deno task *` resolve the whole npm workspace graph in one
# pass, so a lockfile generated without NODE_AUTH_TOKEN would be incomplete and
# would just error out for everyone else. Once a machine with that token runs
# `deno install` at the repo root, commit the resulting deno.lock deliberately.
/deno.lock
/*/deno.lock
/*/*/deno.lock
.claude/

# macOS Finder per-directory view state (icon positions, sort order).
# Per-user, per-machine UI metadata - never belongs in the repo.
.DS_Store
