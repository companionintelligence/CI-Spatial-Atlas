{
  "name": "ci-earth",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "vibe:dev": "vite --host 127.0.0.1 --port 4173",
    "build": "tsc --noEmit && vite build",
    "vibe:build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:visual": "playwright test --config=playwright.config.js",
    "test:visual:update": "playwright test --config=playwright.config.js --update-snapshots",
    "vibe:test": "playwright test --config=playwright.config.js",
    "vibe:test:update": "playwright test --config=playwright.config.js --update-snapshots",
    "vibe:loop": "npm run vibe:build && npm run vibe:test",
    "typecheck": "tsc --noEmit",
    "account:new": "tsx scripts/new-account.ts"
  },
  "dependencies": {
    "three": "^0.179.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^25.5.0",
    "@types/three": "^0.183.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.5"
  }
}
